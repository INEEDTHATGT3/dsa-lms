# Auto-detect text files and normalize line endings to LF in the repo.
* text=auto eol=lf

# Explicit text types
*.js text
*.jsx text
*.mjs text
*.json text
*.md text
*.css text
*.html text
*.yml text
*.yaml text

# Binary types - never touch line endings
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary